# /opt/nikahgator/.env on the Contabo server (chmod 600, never in git). openssl rand -base64 32
DB_NAME=nikahgator
DB_USER=nikahgator
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=28800000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Public address, once the domain is chosen (add it to the shared Caddyfile)
PUBLIC_URL=https://nikahgator.example.org
HTTP_BIND=127.0.0.1:8082
CADDY_NETWORK=rahbar_default
JAVA_OPTS=-Xms256m -Xmx768m
# TAG= is set by deploy.sh
